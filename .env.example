# Copia este archivo a .env.local y rellena con los datos de tu proyecto Supabase
# (Dashboard -> Settings -> API). Sin esto, la app funciona 100% local.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA

# Clave PÚBLICA de VAPID para los avisos con la app cerrada (Web Push).
# Se genera con `npx web-push generate-vapid-keys`; la privada NO va aquí,
# va en los secrets de Edge Functions. Ver supabase/PUSH.md.
VITE_VAPID_PUBLIC_KEY=
